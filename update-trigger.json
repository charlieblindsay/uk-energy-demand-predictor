{
  "name": "cloudrun-update-container-europe-west1-charlieblindsay-uk-enets",
  "description": "Build and deploy service and job on push to main",
  "serviceAccount": "projects/uk-energy-demand-predictor/serviceAccounts/847998595638-compute@developer.gserviceaccount.com",
  "developerConnectEventConfig": {
    "gitRepositoryLink": "projects/uk-energy-demand-predictor/locations/europe-west1/connections/connection-bvi6iei/gitRepositoryLinks/charlieblindsay-uk-energy-demand-predictor",
    "gitRepositoryLinkType": "GITHUB",
    "push": {
      "branch": "main"
    }
  },
  "includedFiles": [
    "Dockerfile",
    "Dockerfile.job",
    "update_data.py",
    "DemandDataLoader.py",
    "DataTransformer.py",
    "weather_config.py",
    "WeatherDataLoader.py",
    "DataLoader.py",
    "DemandDataFrameBuilder.py",
    "DemandModel.py",
    "CloudStorage.py",
    "config.py",
    "cloudbuild.yaml"
  ],
  "build": {
    "options": {
      "logging": "CLOUD_LOGGING_ONLY",
      "requestedVerifyOption": "VERIFIED",
      "substitutionOption": "ALLOW_LOOSE"
    },
    "steps": [
      {
        "name": "gcr.io/cloud-builders/docker",
        "id": "Build service",
        "args": [
          "build",
          "-f",
          "Dockerfile",
          "-t",
          "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-container:$COMMIT_SHA",
          "-t",
          "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-container:latest",
          "."
        ]
      },
      {
        "name": "gcr.io/cloud-builders/docker",
        "id": "Push service",
        "args": [
          "push",
          "--all-tags",
          "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-container"
        ]
      },
      {
        "name": "gcr.io/google.com/cloudsdktool/cloud-sdk:slim",
        "id": "Deploy service",
        "entrypoint": "gcloud",
        "args": [
          "run",
          "services",
          "update",
          "update-container",
          "--image=europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-container:$COMMIT_SHA",
          "--region=europe-west1",
          "--quiet"
        ]
      },
      {
        "name": "gcr.io/cloud-builders/docker",
        "id": "Build job",
        "args": [
          "build",
          "-f",
          "Dockerfile.job",
          "-t",
          "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-demand-data:$COMMIT_SHA",
          "-t",
          "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-demand-data:latest",
          "."
        ]
      },
      {
        "name": "gcr.io/cloud-builders/docker",
        "id": "Push job",
        "args": [
          "push",
          "--all-tags",
          "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-demand-data"
        ]
      },
      {
        "name": "gcr.io/google.com/cloudsdktool/cloud-sdk:slim",
        "id": "Update job",
        "entrypoint": "gcloud",
        "args": [
          "run",
          "jobs",
          "update",
          "update-demand-data",
          "--image=europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-demand-data:$COMMIT_SHA",
          "--region=europe-west1"
        ]
      }
    ],
    "images": [
      "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-container:$COMMIT_SHA",
      "europe-west1-docker.pkg.dev/uk-energy-demand-predictor/cloud-run-source-deploy/update-demand-data:$COMMIT_SHA"
    ]
  }
}